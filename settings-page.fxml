<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.studentmobileapp.pages.settings.SettingsController"
            prefWidth="400" prefHeight="815">
    <center>
        <VBox alignment="TOP_CENTER" spacing="18">
            <padding>
                <Insets top="32" right="24" bottom="16" left="24"/>
            </padding>
            <!-- Title -->
            <Label text="Settings" style="-fx-font-size: 22; -fx-font-weight: bold;" alignment="CENTER"/>
            <!-- Profile Circle and Info -->
            <VBox alignment="CENTER" spacing="6">
                <StackPane>
                    <Circle radius="32" fill="#E2E2E2"/>
                    <Label text="👤" style="-fx-font-size: 28;" />
                </StackPane>
                <Label text="Jane Walker" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                <Label text="1000529835" style="-fx-font-size: 14; -fx-text-fill: #666;"/>
            </VBox>
            <!-- Main Settings Card -->
            <VBox spacing="8">
                <VBox style="-fx-background-color: #fff; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, #E2E2E2, 5, 0.1, 0, 2);" spacing="0">
                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 12 0;">
                        <Label text="👤" style="-fx-font-size: 18;"/>
                        <Label text="User Profile" style="-fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Separator />
                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 12 0;">
                        <Label text="📶" style="-fx-font-size: 18;"/>
                        <Label text="Wireless &amp; Network" style="-fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
                <VBox style="-fx-background-color: #fff; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, #E2E2E2, 5, 0.1, 0, 2);" spacing="0">
                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 12 0;">
                        <Label text="🔔" style="-fx-font-size: 18;"/>
                        <Label text="Notifications" style="-fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Separator />
                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 12 0;">
                        <Label text="🖥️" style="-fx-font-size: 18;"/>
                        <Label text="Appearance" style="-fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Separator />
                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 12 0;">
                        <Label text="📤" style="-fx-font-size: 18;"/>
                        <Label text="Share App" style="-fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Separator />
                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 12 0;">
                        <Label text="📦" style="-fx-font-size: 18;"/>
                        <Label text="Log Out" style="-fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </center>
    <!-- Fixed Bottom Navigation -->
    <bottom>
        <HBox alignment="CENTER" spacing="48" style="-fx-background-color: #fff; -fx-background-radius: 30 30 0 0; -fx-padding: 12;">
            <Button fx:id="homeButton" text="🏠" style="-fx-background-color: transparent; -fx-font-size: 22;" onAction="#goToHome" prefWidth="64" prefHeight="64"/>
            <Button fx:id="favoritesButton" text="📌" style="-fx-background-color: transparent; -fx-font-size: 22;" onAction="#goToFavorites" prefWidth="64" prefHeight="64"/>
            <Button text="👤" style="-fx-background-color: transparent; -fx-font-size: 22;" prefWidth="64" prefHeight="64"/>
        </HBox>
    </bottom>
</BorderPane>